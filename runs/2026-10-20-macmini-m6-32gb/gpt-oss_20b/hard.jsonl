{"model": "gpt-oss:20b", "track": "hard", "task": "hard-code-intervals", "seed": 2, "score": 1.0, "checks": [{"type": "code", "score": 1.0}], "secs": 28.408, "eval_count": 1102, "truncated": false, "cut_in_thinking": false, "answer": "```python\ndef merge_intervals(intervals: list[list[int]]) -> list[list[int]]:\n    # Sort intervals by start without modifying the input\n    sorted_intervals = sorted(intervals, key=lambda x: x[0])\n    merged: list[list[int]] = []\n\n    for start, end in sorted_intervals:\n        if not merged or start > merged[-1][1]:\n            merged.append([start, end])\n        else:\n            merged[-1][1] = max(merged[-1][1], end)\n\n    return merged\n```"}
{"model": "gpt-oss:20b", "track": "hard", "task": "hard-code-roman", "seed": 2, "score": 1.0, "checks": [{"type": "code", "score": 1.0}], "secs": 9.086, "eval_count": 349, "truncated": false, "cut_in_thinking": false, "answer": "```python\ndef roman_to_int(s: str) -> int:\n    \"\"\"\n    Convert a Roman numeral string (up to 3999) to an integer.\n    Supports subtractive notation: IV, IX, XL, XC, CD, CM.\n    \"\"\"\n    roman_map = {\n        'I': 1,\n        'V': 5,\n        'X': 10,\n        'L': 50,\n        'C': 100,\n        'D': 500,\n        'M': 1000,\n    }\n\n    total = 0\n    i = 0\n    n = len(s)\n    while i < n:\n        value = roman_map[s[i]]\n        if i + 1 < n:\n            next_value = roman_map[s[i + 1]]\n            if value < next_value:\n                total += next_value - value\n                i += 2\n                continue\n        total += value\n        i += 1\n    return total\n```"}
